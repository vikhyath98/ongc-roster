# Supabase connection — copy this file to .env and fill in real values.
# Find these in your Supabase project: Settings → API.
# Only the anon (public) key belongs here — never the service_role key.
#
# IMPORTANT: the URL must be the BARE project origin — no path, no trailing
# slash. Just https://<ref>.supabase.co. Do NOT append /rest/v1 (a leftover
# /rest/v1 makes auth call /rest/v1/auth/v1/token and login fails). The same
# applies to the value you set in Vercel's Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
